{
  "name": "roombook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace @roombook/api\" \"npm run dev --workspace @roombook/web\"",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces && tsc --project tsconfig.tools.json",
    "db:validate": "prisma validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "prisma": "7.10.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "dotenv": "^17.0.0"
  }
}
